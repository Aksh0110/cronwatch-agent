{
  "serverId": "srv-001",
  "serverName": "App Server 1",
  "backend": "customer",
  "environment": "staging",
  "cronWatchServer": "http://localhost:3000",
  "heartbeatInterval": 30000,
  "pm2Processes": [
    "customer-cron",
    "admin-cron",
    "partner-cron"
  ],
  "jobs": [
    {
      "name": "Booking Reminder",
      "identifier": "[booking-reminder-cron]",
      "process": "customer-cron",
      "logFile": "/home/ec2-user/.pm2/logs/customer-cron-out.log",
      "enabled": true,
      "rules": [
        {
          "type": "contains",
          "pattern": "Cron job executed",
          "status": "SUCCESS"
        },
        {
          "type": "contains",
          "pattern": "Reminder cron already running",
          "status": "SKIPPED"
        },
        {
          "type": "contains",
          "pattern": "Error executing reminder cron",
          "status": "FAILED"
        }
      ]
    },
    {
      "name": "Coupon",
      "identifier": "Cron job executed",
      "process": "customer-cron",
      "logFile": "/home/ec2-user/.pm2/logs/customer-cron-out.log",
      "enabled": true,
      "rules": [
        {
          "type": "contains",
          "pattern": "Cron job executed",
          "status": "SUCCESS"
        },
        {
          "type": "contains",
          "pattern": "Cron already running",
          "status": "SKIPPED"
        },
        {
          "type": "contains",
          "pattern": "Error executing cron job",
          "status": "FAILED"
        },
        {
          "type": "contains",
          "pattern": "Coupon creation process completed",
          "status": "SUCCESS"
        }
      ]
    },
    {
      "name": "ShareEarn",
      "identifier": "ShareEarn Cron Job",
      "process": "customer-cron",
      "logFile": "/home/ec2-user/.pm2/logs/customer-cron-out.log",
      "enabled": true,
      "rules": [
        {
          "type": "contains",
          "pattern": "started...",
          "status": "STARTED"
        },
        {
          "type": "contains",
          "pattern": "finished for this run",
          "status": "SUCCESS"
        }
      ]
    },
    {
      "name": "Emandate",
      "identifier": "[emandate-cron]",
      "process": "customer-cron",
      "logFile": "/home/ec2-user/.pm2/logs/customer-cron-out.log",
      "enabled": true,
      "rules": [
        {
          "type": "contains",
          "pattern": "Created Razorpay emandate order",
          "status": "SUCCESS"
        },
        {
          "type": "contains",
          "pattern": "Recurring payment failed",
          "status": "FAILED"
        }
      ]
    }
  ]
}