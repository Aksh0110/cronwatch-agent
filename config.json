{
  "serverId": "srv-001",
  "serverName": "App Server 1",
  "backend": "PM2",
  "environment": "production",
  "cronWatchServer": "http://localhost:3000",
  "heartbeatInterval": 30000,
  "pm2Processes": [
    "customer-cron",
    "partner-cron",
    "admin-cron"
  ],
  "jobs": [
    {
      "name": "Booking Reminder",
      "identifier": "[booking-reminder-cron]",
      "process": "customer-cron",
      "logFile": "./logs/customer-cron.log",
      "enabled": true,
      "rules": [
        {
          "type": "contains",
          "pattern": "Cron job executed",
          "status": "SUCCESS"
        }
      ]
    },
    {
      "name": "Retargeting",
      "identifier": "[Retargeting]",
      "process": "customer-cron",
      "logFile": "./logs/customer-cron.log",
      "enabled": true,
      "rules": [
        {
          "type": "contains",
          "pattern": "Start",
          "status": "STARTED"
        },
        {
          "type": "contains",
          "pattern": "Run complete",
          "status": "SUCCESS"
        }
      ]
    },
    {
      "name": "ShareEarn",
      "identifier": "ShareEarn Cron Job",
      "process": "partner-cron",
      "logFile": "./logs/partner-cron.log",
      "enabled": true,
      "rules": [
        {
          "type": "contains",
          "pattern": "started...",
          "status": "STARTED"
        },
        {
          "type": "contains",
          "pattern": "finished for this run",
          "status": "SUCCESS"
        }
      ]
    },
    {
      "name": "Coupon",
      "identifier": "Coupon",
      "process": "admin-cron",
      "logFile": "./logs/admin-cron.log",
      "enabled": true,
      "rules": [
        {
          "type": "contains",
          "pattern": "Coupon creation process completed",
          "status": "SUCCESS"
        }
      ]
    },
    {
      "name": "Emandate",
      "identifier": "[emandate-cron]",
      "process": "customer-cron",
      "logFile": "./logs/customer-cron.log",
      "enabled": true,
      "rules": [
        {
          "type": "contains",
          "pattern": "Created Razorpay emandate order",
          "status": "SUCCESS"
        },
        {
          "type": "contains",
          "pattern": "Recurring payment failed",
          "status": "FAILED"
        }
      ]
    }
  ]
}
